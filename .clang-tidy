Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  clang-diagnostic-unused-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  readability-*,
  misc-const-correctness,
  misc-unused-*,
  misc-no-recursion,
  misc-use-internal-linkage,
  misc-redundant-expression,
  misc-definitions-in-headers,
  misc-header-include-cycle,
  misc-throw-by-value-catch-by-reference,
  concurrency-mt-unsafe,
  cert-err33-c,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-magic-numbers,
  -cppcoreguidelines-pro-type-vararg,
  -modernize-use-trailing-return-type,
  -readability-trailing-comma,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -performance-enum-size,
  -modernize-use-std-print

WarningsAsErrors: >
  bugprone-use-after-move,
  clang-analyzer-core.NullDereference,
  clang-analyzer-cplusplus.NewDeleteLeaks,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-pro-type-cstyle-cast,
  misc-const-correctness

# Compiler diagnostics need their warning flags as well as a matching Checks entry.
ExtraArgs:
  - -Wunused-function
  - -Wunused-variable
  - -Wunused-private-field

CheckOptions:
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key: readability-identifier-naming.TypeAliasCase
    value: CamelCase
  - key: readability-identifier-naming.TemplateParameterCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.MethodCase
    value: lower_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  - key: readability-identifier-naming.MemberCase
    value: lower_case
  - key: readability-identifier-naming.ConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.GlobalConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.StaticConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE

  # Force explicit braces & clearer control flow
  - key: readability-braces-around-statements.ShortStatementLines
    value: 0

  # Judgment-tuned thresholds: flag runs of three or more adjacent same-typed parameters, and
  # functions above 30; justified exceptions carry an explanatory NOLINT.
  - key: bugprone-easily-swappable-parameters.MinimumLength
    value: 3
  - key: readability-function-cognitive-complexity.Threshold
    value: 30
