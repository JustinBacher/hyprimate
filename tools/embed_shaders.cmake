cmake_minimum_required(VERSION 3.25)

# Embed the shaders for one built-in style. Includes are relative to SOURCE_DIR
# and intentionally limited to one level, matching the shader source format.
if(NOT DEFINED SOURCE_DIR OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "SOURCE_DIR and OUTPUT are required")
endif()
if(STYLE STREQUAL "bubble")
    set(namespace bubble_shader)
    set(shaders
        VERTEX=membrane.vert FRAGMENT=membrane.frag
        CURL_VERTEX=curl.vert CURL_FRAGMENT=curl.frag
        PARTICLE_VERTEX=particle.vert PARTICLE_FRAGMENT=particle.frag
        FILM_VERTEX=film.vert FILM_FRAGMENT=film.frag
        MICROBUBBLE_VERTEX=microbubble.vert MICROBUBBLE_FRAGMENT=microbubble.frag)
elseif(STYLE STREQUAL "smoke")
    set(namespace smoke_shader)
    set(shaders
        VERTEX=smoke.vert COMPOSITE=smoke.frag VELOCITY=velocity.frag
        DIVERGENCE=divergence.frag PRESSURE=pressure.frag PROJECT=project.frag
        ADVECT=advect.frag DYE=dye.frag)
elseif(STYLE STREQUAL "swarm")
    set(namespace swarm_shader)
    set(shaders
        SURFACE_VERTEX=surface.vert SURFACE_FRAGMENT=surface.frag
        FIELD_VERTEX=field.vert FIELD_FRAGMENT=field.frag)
else()
    message(FATAL_ERROR "Unknown shader style: ${STYLE}")
endif()

set(header "#pragma once\nnamespace ${namespace} {\n")
foreach(shader IN LISTS shaders)
    string(REPLACE "=" ";" pair "${shader}")
    list(GET pair 0 name)
    list(GET pair 1 filename)
    file(READ "${SOURCE_DIR}/${filename}" remaining)
    string(REPLACE "\r\n" "\n" remaining "${remaining}")
    string(REPLACE "\r" "\n" remaining "${remaining}")
    set(source "")
    while(NOT "${remaining}" STREQUAL "")
        string(FIND "${remaining}" "\n" line_end)
        if(line_end EQUAL -1)
            set(line "${remaining}")
            set(remaining "")
            set(line_break "")
        else()
            string(SUBSTRING "${remaining}" 0 ${line_end} line)
            math(EXPR next_line "${line_end} + 1")
            string(SUBSTRING "${remaining}" ${next_line} -1 remaining)
            set(line_break "\n")
        endif()
        string(REGEX REPLACE "\r$" "" line "${line}")
        if(line MATCHES "^[ \t]*#include[ \t]+\"([^\"]+)\"[ \t]*$")
            set(include_file "${CMAKE_MATCH_1}")
            file(READ "${SOURCE_DIR}/${include_file}" included)
            string(REPLACE "\r\n" "\n" included "${included}")
            string(REPLACE "\r" "\n" included "${included}")
            set(nested_remaining "${included}")
            while(NOT "${nested_remaining}" STREQUAL "")
                string(FIND "${nested_remaining}" "\n" nested_line_end)
                if(nested_line_end EQUAL -1)
                    set(nested_line "${nested_remaining}")
                    set(nested_remaining "")
                else()
                    string(SUBSTRING "${nested_remaining}" 0 ${nested_line_end} nested_line)
                    math(EXPR next_nested_line "${nested_line_end} + 1")
                    string(SUBSTRING "${nested_remaining}" ${next_nested_line} -1 nested_remaining)
                endif()
                string(REGEX REPLACE "\r$" "" nested_line "${nested_line}")
                if(nested_line MATCHES "^[ \t]*#include[ \t]+\"([^\"]+)\"[ \t]*$")
                    message(FATAL_ERROR "${include_file}: nested includes are not supported")
                endif()
            endwhile()
            string(LENGTH "${included}" included_length)
            if(included_length GREATER 0)
                math(EXPR last_index "${included_length} - 1")
                string(SUBSTRING "${included}" ${last_index} 1 last_character)
            else()
                set(last_character "")
            endif()
            if(NOT last_character STREQUAL "\n")
                string(APPEND included "\n")
            endif()
            string(APPEND source "${included}")
        else()
            string(APPEND source "${line}${line_break}")
        endif()
    endwhile()
    string(FIND "${source}" ")SHADER\"" terminator)
    if(NOT terminator EQUAL -1)
        message(FATAL_ERROR "${filename} contains the raw string terminator")
    endif()
    string(APPEND header "inline constexpr auto ${name} = ::std::to_array(R\"SHADER(${source})SHADER\");\n")
endforeach()
string(APPEND header "} // namespace ${namespace}\n")

get_filename_component(output_dir "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${output_dir}")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" existing)
endif()
if(NOT DEFINED existing OR NOT existing STREQUAL header)
    file(WRITE "${OUTPUT}" "${header}")
endif()
