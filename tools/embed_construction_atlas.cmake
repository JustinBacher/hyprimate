# Embed the source PNG without a Python runtime or a second asset copy.
if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "INPUT and OUTPUT are required")
endif()

file(READ "${INPUT}" png_hex HEX)
string(TOLOWER "${png_hex}" png_hex)
string(LENGTH "${png_hex}" hex_length)
if(hex_length LESS 66)
    message(FATAL_ERROR "${INPUT}: expected a PNG signature followed by an IHDR chunk")
endif()
string(SUBSTRING "${png_hex}" 0 16 signature)
string(SUBSTRING "${png_hex}" 16 16 ihdr)
if(NOT signature STREQUAL "89504e470d0a1a0a" OR NOT ihdr STREQUAL "0000000d49484452")
    message(FATAL_ERROR "${INPUT}: expected a PNG signature followed by an IHDR chunk")
endif()
string(SUBSTRING "${png_hex}" 32 8 width_hex)
string(SUBSTRING "${png_hex}" 40 8 height_hex)
math(EXPR width "0x${width_hex}")
math(EXPR height "0x${height_hex}")
if(NOT width EQUAL 512 OR NOT height EQUAL 256)
    message(FATAL_ERROR "${INPUT}: expected 512 x 256, got ${width} x ${height}")
endif()
math(EXPR data_size "${hex_length} / 2")

set(header "#pragma once\n\n#include <array>\n\nnamespace hyprimate::construction_atlas {\n")
string(APPEND header "inline constexpr int WIDTH = ${width};\n")
string(APPEND header "inline constexpr int HEIGHT = ${height};\n")
string(APPEND header "inline constexpr std::array<unsigned char, ${data_size}> PNG{\n")
set(offset 0)
while(offset LESS hex_length)
    set(row "    ")
    set(first_byte TRUE)
    set(row_bytes 0)
    while(row_bytes LESS 16 AND offset LESS hex_length)
        string(SUBSTRING "${png_hex}" ${offset} 2 byte_hex)
        if(NOT first_byte)
            string(APPEND row ", ")
        endif()
        string(APPEND row "0x${byte_hex}")
        set(first_byte FALSE)
        math(EXPR offset "${offset} + 2")
        math(EXPR row_bytes "${row_bytes} + 1")
    endwhile()
    string(APPEND header "${row},\n")
endwhile()
string(APPEND header "};\n}  // namespace hyprimate::construction_atlas\n")

get_filename_component(output_dir "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${output_dir}")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" existing)
endif()
if(NOT DEFINED existing OR NOT existing STREQUAL header)
    file(WRITE "${OUTPUT}" "${header}")
endif()
